{
    "require": {
        "php": ">=8.3",
        "symfony/console": "^6.4",
        "symfony/http-client": "^7.2",
        "symfony/cache": "^7.2",
        "symfony/yaml": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/config": "^7.2",
        "symfony/dotenv": "^7.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Bootstrap\\": "bootstrap/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "lint": "phpcs --standard=PSR12 src/ bootstrap/ tests/",
        "analyze": "phpstan analyse src/ bootstrap/"
    }
}
